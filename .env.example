# Configure these in the SERVER environment, never in app.js or browser storage.
# Optional: path for SQLite and private files (default ./data).
# DAMATA_DATA_DIR=
# Optional: override generated local admin key (default data/admin-token.txt).
# DAMATA_ADMIN_TOKEN=
# Authenticated server-to-server connector for your WhatsApp Business provider.
# WHATSAPP_WEBHOOK_URL=https://your-connector.example/webhook/damata
# WHATSAPP_WEBHOOK_TOKEN=
